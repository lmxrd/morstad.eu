---
import Layout from "../layouts/Layout.astro";
import PostCard from "../components/PostCard.astro";
import PageHeader from "../components/PageHeader.astro";
import { IconRss } from "@tabler/icons-astro";
import { getCollection } from "astro:content";
import { getTagColor } from "../utils/tags.ts";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.disabled)
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  );

// Collect all unique tags for the filter row
const allTags = [...new Set(posts.flatMap((p) => p.data.tags))];
---

<Layout title="Blog">
  <PageHeader current="blog" />

  <!-- RSS alert -->
  <a
    href="/rss.xml"
    class="inline-flex items-center gap-2 mb-5"
    style="padding: 0.625rem 0.875rem; font-size: 0.8125rem; border: 1px solid var(--color-border); border-radius: 4px; color: var(--color-muted); background: var(--color-card); transition: border-color 0.15s; width: max-content;"
  >
    <IconRss size={16} color="var(--color-link)" stroke={2} />
    <span>Subscribe to this blog via RSS</span>
  </a>

  <!-- Tag filter row -->
  <div class="flex flex-wrap gap-1.5 mb-5" id="tag-filters">
    {
      allTags.map((name) => {
        const colors = getTagColor(name);
        return (
          <button
            data-tag={name}
            data-bg={colors.bg}
            data-text={colors.text}
            data-border={colors.border}
            class="blog-tag"
            style={`font-size: 0.625rem; padding: 3px 9px; border-radius: 3px; border: 1px solid ${colors.border}; color: ${colors.text}; cursor: pointer; transition: all 0.15s;`}
          >
            {name}
          </button>
        );
      })
    }
  </div>

  <!-- Post list -->
  <section class="flex flex-col gap-2.5" id="post-list">
    {
      posts.map((post) => (
        <div data-tags={post.data.tags.join(",")}>
          <PostCard post={post} />
        </div>
      ))
    }
  </section>

  <script>
    const filters = document.querySelectorAll<HTMLButtonElement>(".blog-tag");
    const postItems =
      document.querySelectorAll<HTMLDivElement>("#post-list > div");
    const selected = new Set<string>();

    function update() {
      // Update tag button styles
      filters.forEach((btn) => {
        const code = btn.dataset.tag!;
        if (selected.has(code)) {
          btn.style.background = btn.dataset.bg!;
          btn.style.color = btn.dataset.text!;
          btn.style.borderColor = btn.dataset.border!;
        } else {
          btn.style.background = "";
          btn.style.color = btn.dataset.text!;
          btn.style.borderColor = btn.dataset.border!;
        }
      });

      // Filter posts (AND: must have all selected tags)
      postItems.forEach((item) => {
        const tags = (item.dataset.tags ?? "").split(",").filter(Boolean);
        const visible =
          selected.size === 0 || [...selected].every((t) => tags.includes(t));
        item.style.display = visible ? "" : "none";
      });
    }

    filters.forEach((btn) => {
      btn.addEventListener("click", () => {
        const code = btn.dataset.tag!;
        if (selected.has(code)) {
          selected.delete(code);
        } else {
          selected.add(code);
        }
        update();
      });
    });
  </script>
</Layout>
