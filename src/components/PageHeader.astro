---
import { IconHome } from "@tabler/icons-astro";

interface Props {
  current: "work" | "blog" | "about";
  postTitle?: string;
}

const { current, postTitle } = Astro.props;

const pages = [
  { key: "about", label: "About", href: "/about" },
  { key: "work", label: "Work", href: "/work" },
  { key: "blog", label: "Blog", href: "/blog" },
];
---

<header class="mb-5">
  <nav
    aria-label="Breadcrumb"
    class="flex items-center gap-1.5 text-dim mb-3"
    style="font-size: 0.75rem;"
  >
    <a href="/" style="text-decoration: none; color: var(--color-dim);">~</a>
    <span>/</span>
    {
      postTitle ? (
        <a
          href={`/${current}`}
          style="text-decoration: none; color: var(--color-dim);"
        >
          {current}
        </a>
      ) : (
        <span class="text-muted">{current}</span>
      )
    }
    {
      postTitle && (
        <>
          <span>/</span>
          <span
            class="text-muted"
            style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
          >
            {postTitle}
          </span>
        </>
      )
    }
  </nav>

  <div class="flex items-center gap-4">
    <a href="/" aria-label="Home" style="text-decoration: none;">
      <IconHome size={18} color="var(--color-muted)" stroke={2} />
    </a>
    <h1
      class="font-medium text-heading"
      style="font-size: 1.25rem; text-transform: capitalize;"
    >
      {current}
    </h1>
    <nav class="flex gap-3" style="font-size: 0.8125rem;">
      {
        pages.map((page) => (
          <a
            href={page.href}
            style={`text-decoration: none; ${page.key === current ? "color: var(--color-muted); pointer-events: none;" : "color: var(--color-text);"}`}
          >
            {page.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
